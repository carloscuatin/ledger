20" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l9" value="3. 401 → redirects to /oauth2/authorization/ledger" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="260" as="sourcePoint"/><mxPoint x="460.0" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l10" value="4. PAR: POST /oauth2/par (private_key_jwt, code_challenge)" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="300" as="sourcePoint"/><mxPoint x="1040.0" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l11" value="5. request_uri" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040.0" y="340" as="sourcePoint"/><mxPoint x="750.0" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l12" value="6. /authorize?request_uri=… → signs in with passkey (WebAuthn)" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170.0" y="380" as="sourcePoint"/><mxPoint x="1040.0" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l13" value="7. Redirects to /login/oauth2/code/ledger with the code" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040.0" y="420" as="sourcePoint"/><mxPoint x="750.0" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l14" value="8. POST /oauth2/token: code + code_verifier + DPoP proof" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="460" as="sourcePoint"/><mxPoint x="1040.0" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l15" value="9. Opaque token (token_type=DPoP) + ID token" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040.0" y="500" as="sourcePoint"/><mxPoint x="750.0" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n16" value="10. Creates the JDBC session; cookie HttpOnly · Secure · SameSite=Strict" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#ffffff;strokeColor=#bbbbbb;rounded=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="758.0" y="526" width="464.0" height="30" as="geometry"/></mxCell><mxCell id="l17" value="11. POST /bff/api/v1/transfers (cookie + CSRF), amount above threshold" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="580" as="sourcePoint"/><mxPoint x="750.0" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l18" value="12. POST /v1/transfers · Authorization: DPoP · proof with ath" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="620" as="sourcePoint"/><mxPoint x="1330.0" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l19" value="13. Introspection → active, cnf.jkt, tenant_id, acr, auth_time" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330.0" y="660" as="sourcePoint"/><mxPoint x="1040.0" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n20" value="14. Valid DPoP proof; auth_time older than the threshold's max_age" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#ffffff;strokeColor=#bbbbbb;rounded=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1338.0" y="686" width="464.0" height="30" as="geometry"/></mxCell><mxCell id="l21" value="15. 401 insufficient_user_authentication (RFC 9470) with max_age" style="html=1;strokeColor=#b85450;strokeWidth=1.5;dashed=1;endArrow=open;fontSize=10;fontColor=#b85450;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330.0" y="740" as="sourcePoint"/><mxPoint x="750.0" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l22" value="16. Step-up required" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="780" as="sourcePoint"/><mxPoint x="460.0" y="780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l23" value="17. Re-authentication with passkey (steps 4-9 with max_age=0)" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170.0" y="820" as="sourcePoint"/><mxPoint x="1040.0" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l24" value="18. Retries with the new token + new DPoP proof" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="860" as="sourcePoint"/><mxPoint x="1330.0" y="860" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l25" value="19. 201 Created" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330.0" y="900" as="sourcePoint"/><mxPoint x="750.0" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l26" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170.0" y="150" as="sourcePoint"/><mxPoint x="170.0" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l27" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="150" as="sourcePoint"/><mxPoint x="460.0" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l28" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="150" as="sourcePoint"/><mxPoint x="750.0" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l29" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040.0" y="150" as="sourcePoint"/><mxPoint x="1040.0" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l30" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1330.0" y="150" as="sourcePoint"/><mxPoint x="1330.0" y="950" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="7. Dynamic · two-phase transfer"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Dynamic — two-phase transfer from the fintech (DPoP + idempotency)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="36" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Fintech system&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[External]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="270" height="60" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;auth-server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Spring Security 7]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="270" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;ledger-app · api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Spring Boot]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="270" height="60" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Ledger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[PostgreSQL + RLS]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="940" y="90" width="270" height="60" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;ledger-events.fifo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[SNS FIFO]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="270" height="60" as="geometry"/></mxCell><mxCell id="l7" value="1. POST /oauth2/token · client_credentials · private_key_jwt + DPoP proof" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175.0" y="180" as="sourcePoint"/><mxPoint x="475.0" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l8" value="2. Opaque token, token_type=DPoP (bound to cnf.jkt)" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475.0" y="224" as="sourcePoint"/><mxPoint x="175.0" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l9" value="3. POST /v1/transfers {mode: two_phase} · DPoP + proof · Idempotency-Key" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175.0" y="268" as="sourcePoint"/><mxPoint x="775.0" y="268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l10" value="4. Introspection (short cache) → cnf.jkt, tenant_id, scope transfers:write" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775.0" y="312" as="sourcePoint"/><mxPoint x="475.0" y="312" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n11" value="5. Verifies htm, htu, ath and the key; Bucket4j per client" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#ffffff;strokeColor=#bbbbbb;rounded=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="783.0" y="342" width="480.0" height="30" as="geometry"/></mxCell><mxCell id="l12" value="6. BEGIN · SET LOCAL tenant · INSERT idempotency · FOR UPDATE wallets by id" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775.0" y="400" as="sourcePoint"/><mxPoint x="1075.0" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l13" value="7. Validates the policy · places a hold · Transfer PENDING · audit log · outbox · COMMIT" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775.0" y="444" as="sourcePoint"/><mxPoint x="1075.0" y="444" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l14" value="8. 201 Created · Location · status PENDING" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775.0" y="488" as="sourcePoint"/><mxPoint x="175.0" y="488" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l15" value="9. After commit: TransferStatusChangedV1 (MessageGroupId = tenantId)" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775.0" y="532" as="sourcePoint"/><mxPoint x="1375.0" y="532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l16" value="10. POST /v1/transfers/{id}/post · DPoP + new proof · new Idempotency-Key" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175.0" y="576" as="sourcePoint"/><mxPoint x="775.0" y="576" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l17" value="11. BEGIN · releases the hold · 3-posting journal entry (source, destination, fee) · COMMIT" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775.0" y="620" as="sourcePoint"/><mxPoint x="1075.0" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l18" value="12. 200 OK · status POSTED" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775.0" y="664" as="sourcePoint"/><mxPoint x="175.0" y="664" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l19" value="13. JournalEntryPostedV1 + TransferStatusChangedV1" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775.0" y="708" as="sourcePoint"/><mxPoint x="1375.0" y="708" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l20" value="14. Retry of step 10 with the same Idempotency-Key (network timeout)" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175.0" y="752" as="sourcePoint"/><mxPoint x="775.0" y="752" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l21" value="15. The same stored response; money does not move again" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775.0" y="796" as="sourcePoint"/><mxPoint x="175.0" y="796" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l22" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="175.0" y="150" as="sourcePoint"/><mxPoint x="175.0" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l23" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475.0" y="150" as="sourcePoint"/><mxPoint x="475.0" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l24" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775.0" y="150" as="sourcePoint"/><mxPoint x="775.0" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l25" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1075.0" y="150" as="sourcePoint"/><mxPoint x="1075.0" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l26" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1375.0" y="150" as="sourcePoint"/><mxPoint x="1375.0" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n27" value="Variants: VOID releases the hold without a journal entry · on timeout, the expiration job moves it to EXPIRED · the same key with a different body returns 422 · a Bearer with a DPoP token returns 401" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="8. Dynamic · event to webhook"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Dynamic — from journal entry to signed webhook (outbox, fan-out, retries, DLQ)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="36" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;ledger-app · api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Modulith outbox]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;ledger-events.fifo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[SNS FIFO]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;webhooks.fifo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[SQS FIFO + DLQ]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;webhooks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Spring Boot]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="790" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Webhooks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[PostgreSQL]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Fintech endpoint&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[External]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1290" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="n8" value="1. The journal entry and its event_publication row commit in the same transaction" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#ffffff;strokeColor=#bbbbbb;rounded=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="158.0" y="166" width="400.0" height="30" as="geometry"/></mxCell><mxCell id="l9" value="2. Publishes JournalEntryPostedV1 (MessageGroupId = tenantId, content-based dedup)" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="226" as="sourcePoint"/><mxPoint x="400.0" y="226" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l10" value="3. Ack → Modulith marks the publication as completed" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400.0" y="272" as="sourcePoint"/><mxPoint x="150.0" y="272" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l11" value="4. Fan-out to each subscribed queue" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400.0" y="318" as="sourcePoint"/><mxPoint x="650.0" y="318" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l12" value="5. ReceiveMessage (long polling)" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900.0" y="364" as="sourcePoint"/><mxPoint x="650.0" y="364" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l13" value="6. BEGIN · INSERT processed eventId (if present: ack and stop) · creates the delivery · COMMIT" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900.0" y="410" as="sourcePoint"/><mxPoint x="1150.0" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l14" value="7. JWS-signed POST (kid published in the JWKS) · egress via fixed IP" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900.0" y="456" as="sourcePoint"/><mxPoint x="1400.0" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l15" value="8. 2xx" style="html=1;strokeColor=#707070;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400.0" y="502" as="sourcePoint"/><mxPoint x="900.0" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l16" value="9. DeleteMessage" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900.0" y="548" as="sourcePoint"/><mxPoint x="650.0" y="548" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l17" value="8'. 5xx or timeout" style="html=1;strokeColor=#b85450;strokeWidth=1.5;dashed=1;endArrow=open;fontSize=10;fontColor=#b85450;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400.0" y="594" as="sourcePoint"/><mxPoint x="900.0" y="594" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l18" value="9'. ChangeMessageVisibility with exponential backoff; the tenant's group waits in order" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900.0" y="640" as="sourcePoint"/><mxPoint x="650.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n19" value="10'. After maxReceiveCount → DLQ; reprocessed from the console" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#ffffff;strokeColor=#bbbbbb;rounded=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="658.0" y="672" width="400.0" height="30" as="geometry"/></mxCell><mxCell id="l20" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="150" as="sourcePoint"/><mxPoint x="150.0" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l21" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400.0" y="150" as="sourcePoint"/><mxPoint x="400.0" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l22" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650.0" y="150" as="sourcePoint"/><mxPoint x="650.0" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l23" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900.0" y="150" as="sourcePoint"/><mxPoint x="900.0" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l24" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1150.0" y="150" as="sourcePoint"/><mxPoint x="1150.0" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l25" value="" style="html=1;strokeColor=#9a9a9a;dashed=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1400.0" y="150" as="sourcePoint"/><mxPoint x="1400.0" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n26" value="If the app dies between the commit and step 2, Modulith resends the pending publication on restart. A duplicate reaches step 6 and has no effect." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="762" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="9. Dynamic · daily close"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Dynamic — daily close with Spring Batch (partitioned by tenant and restartable)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="36" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[EventBridge Scheduler]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="60" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;ledger-app · batch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Spring Batch]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="260" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;JobRepository&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[PostgreSQL, BATCH_*]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="260" height="60" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Ledger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[PostgreSQL + RLS]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="910" y="90" width="260" height="60" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Audit anchors&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[S3 Object Lock]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontSize=11;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="260" height="60" as="geometry"/></mxCell><mxCell id="l7" value="1. 00:00 COT · RunTask profile=batch · job=dailyClose, date=D" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170.0" y="180" as="sourcePoint"/><mxPoint x="460.0" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l8" value="2. JobInstance(date=D): COMPLETED → exits · FAILED → resumes" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="226" as="sourcePoint"/><mxPoint x="750.0" y="226" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n9" value="3. Partitioner: one partition per tenant (in parallel)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#ffffff;strokeColor=#bbbbbb;rounded=1;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="468.0" y="258" width="464.0" height="30" as="geometry"/></mxCell><mxCell id="l10" value="4. Per partition: SET LOCAL tenant · reads accounts by id in chunks" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="318" as="sourcePoint"/><mxPoint x="1040.0" y="318" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l11" value="5. Closing balance = previous close + postings of day D → INSERT closing_balance" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="364" as="sourcePoint"/><mxPoint x="1040.0" y="364" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l12" value="6. COMMIT per chunk with the last processed id in the step context" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="410" as="sourcePoint"/><mxPoint x="750.0" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l13" value="7. Verifies Σ debits = Σ credits for the day per currency · BusinessDay D → CLOSED" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="456" as="sourcePoint"/><mxPoint x="1040.0" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l14" value="8. Reads the head of the tenant's sealed audit log chain" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="502" as="sourcePoint"/><mxPoint x="1040.0" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l15" value="9. Writes the day's anchor (compliance mode: nobody can delete or change it)" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="548" as="sourcePoint"/><mxPoint x="1330.0" y="548" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l16" value="10. JobExecution COMPLETED" style="html=1;strokeColor=#3C7FC0;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="594" as="sourcePoint"/><mxPoint x="750.0" y="594" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n17" value="Failure at step 5: the 