<mxGeometry x="60" y="120" width="220" height="80" as="geometry"/></mxCell><mxCell id="n4" value="console-bff [Container: Spring Boot 4]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="960" height="640" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Security filter chain&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Spring Security]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Mandatory session, CSRF (cookie + header), strict CSP; ends the session on an API 401&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="280" height="120" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Routes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Gateway Server MVC]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/bff/api/** → ledger-app&lt;br&gt;/bff/webhooks/** → webhooks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="270" width="280" height="110" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;DPoP relay&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Custom HandlerFilterFunction]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Authorization: DPoP + per-request proof (htm, htu, ath)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="280" height="110" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;OIDC login&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[oauth2Login]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;PAR + PKCE, private_key_jwt; user data from the ID token&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="110" width="280" height="120" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;DPoP token client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[RestClient token client + setHeadersConverter]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Adds the DPoP proof when requesting and refreshing tokens&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="270" width="280" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Authorized client manager&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[OAuth2AuthorizedClientManager]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Returns the session's current token and refreshes it&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="280" height="110" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Session&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Spring Session JDBC]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Stores the user's tokens; 15 min idle, 8 h maximum&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="590" width="280" height="100" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Key provider&lt;/b&gt;&lt;br&gt;&lt;span style=&quot