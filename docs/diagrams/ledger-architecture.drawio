<mxfile host="drawio"><diagram id="p0" name="1. C4 · Context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Level 1 — System context" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="n2" value="Who uses the Ledger platform and which external systems it interacts with" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="900" height="24" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Fintech team&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;A tenant's finance staff, approvers and developers&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="240" height="120" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Platform admin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tenant onboarding and global configuration; no access to tenant data except via break-glass&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="240" height="130" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Ledger platform&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Software system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Multi-tenant wallets in COP, extensible to other currencies: direct and two-phase transfers, fees, limits, daily close, reconciliation against the bank, web console and signed webhooks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="210" width="380" height="200" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Fintech system&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[External software system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Moves its customers' money and receives notifications&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="380" height="120" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Bank&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[External software system]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Drops the daily bank statement of the settlement account&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1160" y="230" width="260" height="130" as="geometry"/></mxCell><mxCell id="e8" value="Reconciles, approves adjustments,&lt;br&gt;registers OAuth2 clients&lt;br&gt;[HTTPS, passkeys]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="Onboards tenants&lt;br&gt;and configures&lt;br&gt;[HTTPS, passkeys]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="Moves money and queries balances&lt;br&gt;[REST /v1, FAPI 2.0 + DPoP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="n6" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="Notifies status changes&lt;br&gt;[JWS-signed webhooks]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;dashed=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="Delivers the daily bank statement&lt;br&gt;[CSV in object storage]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.4;" edge="1" parent="1" source="n7" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="&lt;b&gt;Business invariants&lt;/b&gt;&lt;br&gt;• Every journal entry balances per currency: Σ debits = Σ credits&lt;br&gt;• A posted journal entry is immutable; it is corrected with a reversing entry&lt;br&gt;• The same Idempotency-Key never moves money twice&lt;br&gt;• A wallet never goes below its policy (minimum balance or overdraft)&lt;br&gt;• A tenant never sees another tenant's data&lt;br&gt;• Manual adjustments and policy changes: dual approval" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="460" height="130" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1300" y="700" width="200" height="24" as="geometry"/></mxCell><mxCell id="n15" value="Person" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1300" y="728" width="200" height="28" as="geometry"/></mxCell><mxCell id="n16" value="Our system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1300" y="762" width="200" height="28" as="geometry"/></mxCell><mxCell id="n17" value="External system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1300" y="796" width="200" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. C4 · Containers (phase 1)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Level 2 — Containers, phase 1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="n2" value="What is deployed separately, with which technology, and how it communicates" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="900" height="24" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Fintech team / Admin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Person]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height="80" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Fintech system&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[External system]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1580" y="120" width="200" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Bank&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[External system]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#8C8496;strokeColor=#736782;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1580" y="800" width="200" height="80" as="geometry"/></mxCell><mxCell id="n6" value="Ledger platform [Software system]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;dashed=1;dashPattern=8 4;strokeColor=#666666;fontColor=#333333;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="1250" height="900" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Web console&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: React + Vite, served from a CDN]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Finance, Administration and Developers areas; never receives tokens&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="260" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;console-bff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Spring Boot 4, Gateway Server MVC]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;OIDC login, session, CSRF, CSP; forwards to the APIs with opaque token + DPoP&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="260" height="130" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Sessions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[PostgreSQL]&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="560" width="220" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;auth-server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Spring Security 7 Authorization Server]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Passkeys, PAR, PKCE, private_key_jwt, opaque DPoP tokens, introspection, client registration&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="300" height="130" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Identities&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[PostgreSQL]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;users, clients, WebAuthn&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="220" height="100" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;ledger-app · api&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Spring Boot 4, Spring Modulith]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ledger, approvals, audit and reconciliation modules; REST API /v1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="740" y="330" width="300" height="130" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;ledger-app · batch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Spring Batch, scheduled task]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Daily close per tenant and reconciliation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="740" y="800" width="300" height="110" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Ledger&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[PostgreSQL + RLS]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;accounts, journal entries, audit log, outbox, BATCH_*&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="260" height="110" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;ledger-events.fifo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[SNS FIFO]&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="360" width="200" height="80" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;webhooks.fifo + DLQ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[SQS FIFO]&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="520" width="200" height="80" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;webhooks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Container: Spring Boot 4]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Subscriptions, JWS-signed deliveries, retries&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1360" y="330" width="160" height="140" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Webhooks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[PostgreSQL]&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1360" y="620" width="160" height="80" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Object storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[S3]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;bank statements, audit anchors (WORM)&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1120" y="810" width="240" height="100" as="geometry"/></mxCell><mxCell id="e20" value="Uses&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n3" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="Calls /bff/*&lt;br&gt;[JSON/HTTPS, session cookie]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="OIDC login with PAR + PKCE,&lt;br&gt;requests DPoP tokens [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.7;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="Forwards with&lt;br&gt;opaque token + DPoP&lt;br&gt;[JSON/HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;entryX=0;entryY=0.6;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="Stores the session&lt;br&gt;[JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="[JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="Introspection&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="n12" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="Reads and writes&lt;br&gt;[JDBC, SET LOCAL tenant]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="Closes the day, reconciles&lt;br&gt;[JDBC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="Reads statements,&lt;br&gt;writes anchors [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n13" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="Publishes v1 events&lt;br&gt;[outbox, HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;dashed=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="Fans out&lt;br&gt;[subscription]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;dashed=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="Consumes&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;dashed=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exit