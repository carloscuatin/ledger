yle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="audit log record&lt;br&gt;in the same transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888888;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.1;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="PL: v1 events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n3" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="webhook JWS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#707070;strokeWidth=1.5;dashed=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="Conformist: OAuth2/OIDC&lt;br&gt;(scopes, roles, tenant_id, acr)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#888888;strokeWidth=1;dashed=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="&lt;b&gt;Ubiquitous language&lt;/b&gt; (console → code)&lt;br&gt;account → Account · journal entry → JournalEntry · posting → Posting&lt;br&gt;transfer → Transfer · hold → PENDING · fee → Fee&lt;br&gt;business day → BusinessDay · value date → valueDate&lt;br&gt;bank statement → BankStatement · discrepancy → Discrepancy&lt;br&gt;adjustment → Adjustment · approval → Approval" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="640" width="420" height="120" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Explicit exception&lt;/b&gt;&lt;br&gt;Posting a transfer touches Transfer,&lt;br&gt;2-3 Accounts and creates a JournalEntry&lt;br&gt;in a single transaction: money&lt;br&gt;requires atomicity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="280" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="14. Supplementary · platform contract"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Supplementary — platform contract: what the app needs and how each cloud provides it" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="36" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;The app only knows&lt;/b&gt;: OCI image · environment variables · PostgreSQL 16+ · object storage port · event port · OTLP to a collector and JSON logs to stdout. No cloud SDK outside an adapter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1340" height="50" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Capability&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="320" height="44" as="geometry"/>