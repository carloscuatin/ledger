AT + reserved IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="548" width="340" height="52" as="geometry"/></mxCell><mxCell id="n38" value="NAT Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="548" width="340" height="52" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Secrets and own keys&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="320" height="52" as="geometry"/></mxCell><mxCell id="n40" value="Secrets Manager + KMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="600" width="340" height="52" as="geometry"/></mxCell><mxCell id="n41" value="Secret Manager + Cloud KMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="600" width="340" height="52" as="geometry"/></mxCell><mxCell id="n42" value="Key Vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="600" width="340" height="52" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;Observability&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="652" width="320" height="52" as="geometry"/></mxCell><mxCell id="n44" value="ADOT → CloudWatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="652" width="340" height="52" as="geometry"/></mxCell><mxCell id="n45" value="OTel Collector → Cloud&lt;br&gt;Logging and Monitoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="652" width="340" height="52" as="geometry"/></mxCell><mxCell id="n46" value="Azure Monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="652" width="340" height="52" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b&gt;Terraform provider&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="704" width="320" height="52" as="geometry"/></mxCell><mxCell id="n48" value="hashicorp/aws&lt;br&gt;local: Floci" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="704" width="340" height="52" as="geometry"/></mxCell><mxCell id="n49" value="hashicorp/google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="704" width="340" height="52" as="geometry"/></mxCell><mxCell id="n50" value="hashicorp/azurerm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="704" width="340" height="52" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;• Every cloud fulfills the full contract: WAF, own keys and official Terraform&lt;br&gt;• Standard Postgres only, with Flyway migrations&lt;br&gt;• Terraform: one module per provider with the same outputs&lt;br&gt;• The same image runs on AWS and GCP; the event externalizer is chosen by configuration" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="860" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>